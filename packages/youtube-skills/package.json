{
  "name": "@video2ctx/youtube-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Private source, tests, and bundling for the video2ctx YouTube agent skills.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/build-bundles.mjs",
    "bundle:check": "node scripts/build-bundles.mjs --check",
    "verify": "npm test && npm run typecheck && npm run bundle:check"
  },
  "dependencies": {
    "all-things-youtube": "file:../all-things-youtube",
    "he": "^1.2.0",
    "striptags": "^3.2.0",
    "undici": "6.28.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "esbuild": "0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
