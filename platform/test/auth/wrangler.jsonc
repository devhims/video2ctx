{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "video2ctx-auth-test",
  "main": "../auth-worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "POLAR_ENVIRONMENT": "sandbox",
    "POLAR_ACCESS_TOKEN": "test-only-polar-token",
    "POLAR_BUILDER_PRODUCT_ID": "builder-product",
    "STARTER_ONBOARDING_CREDITS": "5000",
    "BUILDER_MONTHLY_CREDITS": "10000",
    "POLAR_WEBHOOK_SECRET": "whsec_c2FuZGJveC1zaWduYXR1cmUtdGVzdC1rZXktMzI=",
    "APP_ORIGIN": "http://auth.test",
    "AUTH_BASE_URL": "http://auth.test",
    "AUTH_PREVIEW_HOST_PATTERN": "video2ctx-web-*-devhims-projects.vercel.app",
    "BETTER_AUTH_SECRET": "test-only-better-auth-secret-000000000000",
    "OAUTH_PROXY_SECRET": "test-only-oauth-proxy-secret-0000000000",
    "GITHUB_CLIENT_ID": "test-github-client",
    "GITHUB_CLIENT_SECRET": "test-github-secret",
    "GOOGLE_CLIENT_ID": "test-google-client",
    "GOOGLE_CLIENT_SECRET": "test-google-secret",
    "AGENT_RUNTIME_ENABLED": "true",
    "AGENT_ACCESS_MODE": "allowlist",
    "ADMIN_EMAILS_SECRET": "bootstrap-admin@example.test"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "video2ctx-auth-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "USER_ACCOUNT", "class_name": "UserAccountDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserAccountDO"] }],
  "r2_buckets": [{"binding":"RESEARCH","bucket_name":"agent-trace-auth-test"}],
  "queues": {
    "producers": [
      { "binding": "EMAIL_TASKS", "queue": "video2ctx-auth-test-email" }
    ]
  }
}
