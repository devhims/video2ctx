{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "video2ctx",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  // Some backing Cloudflare resources retain their pre-video2ctx deployment
  // names. Changing those identifiers requires a separately planned data and
  // traffic migration; they are not product-facing brand names.
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://www.video2ctx.dev",
    "AUTH_BASE_URL": "https://www.video2ctx.dev",
    "EMAIL_FROM": "noreply@video2ctx.dev",
    "AI_GATEWAY_ID": "all-things-youtube",
    "PUBLIC_SEARCH_INSTANCE": "youtube-public",
    "ADMIN_EMAILS": "",
    "FREE_ONBOARDING_CREDITS": "1000",
    "PRO_MONTHLY_CREDITS": "2000",
    "FREE_PROJECT_LIMIT": "3",
    "FREE_MONITOR_LIMIT": "1",
    "FREE_DAILY_IMPORTS": "10",
    "PRO_PROJECT_LIMIT": "100",
    "PRO_MONITOR_LIMIT": "50",
    "PRO_DAILY_IMPORTS": "200",
    "YOUTUBE_PROCESSOR_INSTANCE_COUNT": "2",
    "YOUTUBE_PROCESSOR_VERSION": "v1",
    "YOUTUBE_PROCESSOR_MAX_ATTEMPTS": "2",
    "YOUTUBE_PROCESSOR_TIMEOUT_MS": "120000",
    "YOUTUBE_PROCESSOR_RETRY_BASE_MS": "25",
    "YOUTUBE_PROCESSOR_MAX_CONCURRENCY": "4"
  },
  "containers": [
    {
      "class_name": "YouTubeProcessorContainer",
      "name": "all-things-youtube-platform-youtubeprocessorcontainer",
      "image": "./youtube-processor/Dockerfile",
      "image_build_context": "./youtube-processor",
      "instance_type": "lite",
      "max_instances": 4
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "YOUTUBE_PROCESSOR",
        "class_name": "YouTubeProcessorContainer"
      },
      {
        "name": "YOUTUBE_REQUEST_COORDINATOR",
        "class_name": "YouTubeRequestCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["YouTubeProcessorContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["YouTubeRequestCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "all-things-youtube-production",
      "database_id": "4f173c2a-8c42-49ef-b36d-07a91533f029",
      "preview_database_id": "633b783e-9fd9-402b-923a-2c8cb052bc69",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "YOUTUBE_CACHE",
      "id": "a7f3dabd47684ce8ada36680fb6fa527",
      "preview_id": "08ae98076be441388d077d5087cc7c2f",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESEARCH",
      "bucket_name": "all-things-youtube-private"
    }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      { "binding": "TASKS", "queue": "all-things-youtube-tasks" },
      { "binding": "EMAIL_TASKS", "queue": "all-things-youtube-email" }
    ],
    "consumers": [
      {
        "queue": "all-things-youtube-tasks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "all-things-youtube-tasks-dlq",
        "max_retries": 5
      },
      {
        "queue": "all-things-youtube-email",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "all-things-youtube-email-dlq",
        "max_retries": 5
      }
    ]
  },
  "workflows": [
    {
      "binding": "IMPORT_WORKFLOW",
      "name": "youtube-import-workflow",
      "class_name": "ImportWorkflow"
    },
    {
      "binding": "MONITOR_WORKFLOW",
      "name": "youtube-monitor-workflow",
      "class_name": "MonitorWorkflow"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["0 * * * *", "0 8 * * *", "0 8 * * 1"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
