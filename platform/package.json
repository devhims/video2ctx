{
  "name": "video2ctx-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development --var APP_ORIGIN:http://localhost:3000 --var AUTH_BASE_URL:http://localhost:3000",
    "dev:local": "wrangler dev --local --var ENVIRONMENT:development --var APP_ORIGIN:http://localhost:3000 --var AUTH_BASE_URL:http://localhost:3000",
    "build": "tsc --noEmit",
    "test": "vitest run && npm --prefix youtube-processor test",
    "verify": "npm ci --prefix youtube-processor && npm run build && npm test",
    "test:container": "npm --prefix youtube-processor test",
    "types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:production": "npm run db:migrate:production && npm run deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --preview",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.26",
    "@cloudflare/containers": "0.3.7",
    "@scalar/hono-api-reference": "^0.11.12",
    "@upstash/redis": "^1.38.2",
    "all-things-youtube": "0.1.1",
    "better-auth": "1.6.26",
    "better-call": "1.3.7",
    "he": "^1.2.0",
    "hono": "^4.13.1",
    "stripe": "^18.5.0",
    "striptags": "^3.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "@types/he": "^1.2.0",
    "@types/node": "^25.9.5",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "4.120.0"
  }
}
