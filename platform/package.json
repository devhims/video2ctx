{
  "name": "video2ctx-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MINIFLARE_CONTAINER_EGRESS_IMAGE_PLATFORM=linux/amd64 wrangler dev --var ENVIRONMENT:development --var APP_ORIGIN:http://localhost:3000 --var AUTH_BASE_URL:http://localhost:3000",
    "dev:local": "MINIFLARE_CONTAINER_EGRESS_IMAGE_PLATFORM=linux/amd64 wrangler dev --local --var ENVIRONMENT:development --var APP_ORIGIN:http://localhost:3000 --var AUTH_BASE_URL:http://localhost:3000",
    "build": "tsc --noEmit",
    "test": "vitest run && npm --prefix youtube-processor test",
    "test:auth:integration": "vitest run --config vitest.auth.config.ts",
    "test:payments:integration": "vitest run --config vitest.auth.config.ts test/billing.integration.test.ts test/credits.integration.test.ts",
    "test:auth:e2e": "playwright test --config playwright.auth.config.ts",
    "verify": "npm ci --prefix youtube-processor && npm run build && npm test && npm run test:auth:integration",
    "test:auth": "vitest run test/auth-config.test.ts test/authentication.test.ts test/cli-auth-boundary.test.ts test/account-route.test.ts",
    "test:container": "npm --prefix youtube-processor test",
    "types": "wrangler types",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:check": "tsx scripts/generate-docs.ts --check",
    "deploy": "wrangler deploy",
    "deploy:production": "npm run db:migrate:production && npm run deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --preview",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.26",
    "@cloudflare/containers": "0.3.7",
    "@polar-sh/better-auth": "1.8.4",
    "@polar-sh/sdk": "0.47.1",
    "@scalar/hono-api-reference": "^0.11.12",
    "@upstash/redis": "^1.38.2",
    "all-things-youtube": "0.2.2",
    "better-auth": "1.6.26",
    "better-call": "1.3.7",
    "he": "^1.2.0",
    "hono": "^4.13.1",
    "react": "19.2.8",
    "react-email": "6.9.2",
    "striptags": "^3.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "5.20260815.1",
    "@playwright/test": "^1.62.1",
    "@types/he": "^1.2.0",
    "@types/node": "^25.9.5",
    "@types/react": "19.2.18",
    "tsx": "4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "4.120.0"
  }
}
