{
  "name": "video2ctx-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "node dev-local.mjs",
    "dev:web": "npm --prefix web run dev",
    "dev:platform": "npm --prefix platform run dev",
    "docs:dev": "npm --prefix docs run dev",
    "docs:generate": "npm --prefix platform run docs:generate",
    "docs:check": "npm --prefix platform run docs:check",
    "docs:verify": "npm --prefix docs run verify",
    "build:library": "npm --prefix packages/all-things-youtube run build",
    "test:library": "npm --prefix packages/all-things-youtube run test",
    "pack:library": "npm --prefix packages/all-things-youtube pack",
    "build": "npm run build:library && npm --prefix platform run build && npm --prefix web run build",
    "test": "npm run test:library && npm --prefix platform run test"
  }
}
